# Copy this file to .env and fill it in. .env is gitignored; never commit it.

# Wallet private key, used to log into pump.fun and to know which wallet's buys to watch.
# Base58 (Phantom: Settings → Manage Accounts → Show Private Key) or a solana-keygen JSON array.
# Use a dedicated trading wallet, not your main one.
PRIVATE_KEY=

# Anthropic API key for writing the one-sentence summary (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Solana RPC endpoint (HTTP). The public one works but rate-limits; a free Helius/QuickNode URL is better.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How often to check the wallet for new transactions, in milliseconds.
POLL_INTERVAL_MS=3000

# Optional: also post every call to a Telegram chat or channel.
# Create a bot with @BotFather, add it to the chat, and put the chat id here (channels look like -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Claude model used for summaries.
# CLAUDE_MODEL=claude-opus-5-5
